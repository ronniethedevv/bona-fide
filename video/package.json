{
  "name": "bona-fide-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion demo video for Bona Fide \u2014 titles and captions over real, scripted app footage.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture-clips.mjs",
    "studio": "remotion studio",
    "render": "remotion render src/index.ts Demo out/bona-fide-demo.mp4 --browser-executable=/opt/pw-browsers/chromium",
    "typecheck": "tsc --noEmit",
    "analyze": "node scripts/analyze-vo.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@remotion/cli": "4.0.543",
    "@remotion/media-parser": "^4.0.543",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "playwright-core": "^1.65.0",
    "typescript": "5.9.3"
  }
}