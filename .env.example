# Bona Fide — environment variable NAMES only. Never put real values here.
# Copy to .env (gitignored) and fill in locally / in your TEE deployment.

# --- Agent (Shade Agent template vars) ---
# NEAR account ID of the deployed agent contract (see contract/ and deployment.yaml).
AGENT_CONTRACT_ID=
# Sponsor NEAR account that funds the agent. Generate with:
#   shade auth set near testnet create-new
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=

# --- Agent (Bona Fide) ---
# NEAR network: testnet | mainnet
NEAR_NETWORK=testnet
# Data source for a run: live | replay   (replay is always labelled Replay on-chain)
DATA_SOURCE=replay
# Directory of replay fixtures (honest MM, dumping MM, key-revoked, outage).
REPLAY_FIXTURES_DIR=fixtures/replay
# HTTP port for the agent's intake / health server.
PORT=3000

# --- Web (Vite — must be prefixed VITE_ to reach the browser) ---
# NEAR network the web app talks to.
VITE_NEAR_NETWORK=testnet
# Deployed Bona Fide contract account ID the web app reads from.
VITE_CONTRACT_ID=
# Base URL of the hosted agent's key-intake endpoint.
VITE_AGENT_URL=

# --- Phala Cloud (TEE deploy; CLI reads these, do not commit real keys) ---
# API key from https://cloud.phala.network/dashboard/tokens
PHALA_API_KEY=
